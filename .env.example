# Offline shop / local PC — default. No cloud DB required.
# Database file: data/pos.sqlite
# Login cookie secret file (auto-created): data/session.secret

# Optional: override cookie secret (otherwise data/session.secret is used)
# SESSION_SECRET=

# --- Legacy cloud only (do NOT set for normal shop use) ---
# POS_USE_TURSO=1
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
